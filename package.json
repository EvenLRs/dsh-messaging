{
  "name": "dsh-messaging",
  "version": "0.2.0",
  "description": "DSH 消息渠道网关：静态 Host + 静态 Client 半区",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvenLRs/dsh-messaging.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "messaging",
    "onebot",
    "telegram",
    "discord",
    "slack",
    "lark",
    "wecom",
    "wechat"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "ws": "^8.18.0"
  },
  "scripts": {
    "test": "node test/qrcode-smoke.cjs && node test/login-qr-route.cjs && node test/session-id-migration.cjs && node test/host-smoke.cjs && node test/http-routes.cjs && node test/client-smoke.cjs && node test/client-login-flow.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "companion",
    "config.example.json",
    "cordis.patch.yml"
  ]
}
